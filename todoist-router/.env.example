# Copy to .env for local dev; on Railway set these as service Variables.
# Do NOT put real secrets in this file — it's committed. Real values go in .env.

# Todoist App Management → your app → Client secret (used for webhook HMAC verify)
TODOIST_CLIENT_SECRET=

# Todoist → Settings → Integrations → Developer → API token (task lookup)
TODOIST_API_TOKEN=

# Pushcut → Account → API key
PUSHCUT_API_KEY=

# The ONE Pushcut notification every reminder fires to (create it in the Pushcut
# app). The per-task SOUND is set in code (routes.js) via the payload, so you do
# NOT need a separate notification per tier — just this one.
PUSHCUT_NOTIFICATION_NAME=TodoistTaskReminder

# Sounds per task type live in routes.js (label/priority → sound), not here.
# Built-in Pushcut sounds need no setup; custom sounds must be imported into the
# Pushcut app by name on the receiving device.

# --- Pushover (CRITICAL/urgent tier only) ---
# Pushcut can't send iOS Critical Alerts (Apple denied it the entitlement), so the
# `critical: true` tier in routes.js goes through Pushover, which DOES pierce the
# mute switch + DnD. Leave these blank and the urgent tier falls back to Pushcut.
# Setup: install Pushover on the phone(s), enable Critical Alerts + grant the iOS
# permission + set a volume, then get your user key and create an app token.
PUSHOVER_TOKEN=            # Pushover → Your Applications → create one for this router
PUSHOVER_USER_KEY=         # Pushover dashboard → your user key
# Optional tuning:
# PUSHOVER_SOUND=siren     # a Pushover sound name (default: siren)
# PUSHOVER_PRIORITY=1      # 1 = high (critical, no ack); 2 = emergency (repeat until acked)
# PUSHOVER_RETRY=60        # priority 2 only: resend interval (seconds)
# PUSHOVER_EXPIRE=600      # priority 2 only: stop retrying after (seconds)

# Optional; Railway sets PORT automatically, defaults to 3000 locally
# PORT=3000
