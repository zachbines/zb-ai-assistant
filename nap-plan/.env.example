# Copy to .env for local dev (run with: node --env-file=.env server.js);
# on Railway set these as service Variables. Real values never go in this file.

# Todoist → Settings → Integrations → Developer → API token
# (the same token todoist-router uses)
TODOIST_API_TOKEN=

# Any passcode you choose. The page asks for it once per device before it can
# add tasks, so strangers who find the URL can't fill your Todoist.
NAP_PLAN_PASSCODE=

# Optional; Railway sets PORT automatically, defaults to 3000 locally
# PORT=3000
